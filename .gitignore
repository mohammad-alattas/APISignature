# in history for every rebuild, permanently.
dist/
*.db
*.db-journal
*.db-wal

# Plugin binaries
*.dp32
*.dp64

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.idea/
.vscode/
*.user
Thumbs.db
desktop.ini
